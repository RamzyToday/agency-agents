# Claude API (required — get yours at console.anthropic.com)
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...

# OpenAI Whisper API (required for voice transcription)
EXPO_PUBLIC_OPENAI_API_KEY=sk-...

# Notion sync (optional — get token at notion.so/my-integrations)
# Database must have: Name (title), Status (select), Quadrant (select),
# Deadline (date), Effort (min) (number), Notes (rich_text), FocusID (rich_text)
EXPO_PUBLIC_NOTION_TOKEN=secret_...
EXPO_PUBLIC_NOTION_DATABASE_ID=your-database-id-from-url

# Google Calendar OAuth (required for calendar integration)
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
# Enable "Google Calendar API" and create OAuth 2.0 Client IDs (one per platform)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Twilio (optional — for SMS reminders, Phase 2)
# EXPO_PUBLIC_TWILIO_ACCOUNT_SID=AC...
# EXPO_PUBLIC_TWILIO_AUTH_TOKEN=...
# EXPO_PUBLIC_TWILIO_FROM_NUMBER=+1...
