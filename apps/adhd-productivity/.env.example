# Claude API (required — get yours at console.anthropic.com)
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...

# OpenAI Whisper API (required for voice transcription)
EXPO_PUBLIC_OPENAI_API_KEY=sk-...

